# ---------------------------------------------------------------------------
# Add these to .env on every machine. Together they are the whole storage
# setup: no folder picking, no per-person configuration.
# ---------------------------------------------------------------------------

# --- The one Drive the library lives in -------------------------------------
# The account that owns the books. Everyone's uploads are written by this
# account, whoever is signed in. It must sign in to the portal once per
# installation so the portal has a refresh token for it.
DRIVE_OWNER_EMAIL=cheanlyheng@rua.edu.kh

# The main folder. Open it in Drive and copy the ID out of the address bar:
#   drive.google.com/drive/folders/<THIS PART>
# The value below is the សារណា folder from your screenshot.
DRIVE_ROOT_FOLDER_ID=1m-FSCDUQUK-L3s5Gt-KayidOQ8AWux4R

# Only used for display, on the upload and storage pages.
DRIVE_ROOT_FOLDER_NAME=សារណា

# Optional, and the reason a new machine needs no sign-in at all: paste the
# owner's Google refresh token here and DRIVE_OWNER_EMAIL is not consulted.
# Copy it out of the database after the owner has signed in once:
#   SELECT driveRefreshToken FROM User WHERE email = 'cheanlyheng@rua.edu.kh';
# Treat it like a password - it grants full Drive access to that account.
# DRIVE_OWNER_REFRESH_TOKEN=

# --- Who may add books ------------------------------------------------------
# VIEWER (default) keeps the old behaviour: read-only until promoted.
# UPLOADER lets anyone who is allowed to sign in also add books. Combined with
# ALLOWED_EMAIL_DOMAINS below, that means every rua.edu.kh account can upload
# and nobody else can even sign in.
DEFAULT_ROLE=UPLOADER

# Still works, and still only matters when DEFAULT_ROLE=VIEWER.
BOOTSTRAP_UPLOADER_EMAILS=

# Keep this set. With DEFAULT_ROLE=UPLOADER it is the only thing standing
# between the library and any Google account on earth.
ALLOWED_EMAIL_DOMAINS=rua.edu.kh
