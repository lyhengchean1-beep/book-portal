generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  VIEWER   // can browse and read
  UPLOADER // can add books
  ADMIN    // can add, remove, and choose the active year folder
}

enum BookStatus {
  PENDING // row created, Drive upload not confirmed yet
  READY   // file is on Drive and shared
  FAILED  // upload failed; row kept for auditing
}

model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String   @unique
  name      String?
  image     String?  @db.Text // Google avatar URLs run past 191 characters
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  // Granted at sign-in. Only the library Drive account's token is ever used to
  // read or write files - see DRIVE_OWNER_EMAIL. Everyone else's is stored so
  // that ownership of the library can be moved to another account by changing
  // one environment variable, with no re-consent dance.
  driveRefreshToken String? @db.Text

  // Left over from the per-user destination the portal used to have. Nothing
  // reads them now. Kept so that `prisma db push` does not drop columns on an
  // existing database; delete the four lines once you are sure.
  driveId    String?
  driveName  String?
  folderId   String?
  folderName String?

  books Book[]
}

model Faculty {
  id   String @id @default(cuid())
  code String @unique @db.VarChar(8)  // shown on the record card, e.g. AGR
  name String @unique @db.VarChar(191)

  /// Name of this faculty's folder inside the year folder on Drive. Set it
  /// when the folder that already exists does not match `code` - the portal
  /// files into an existing folder rather than creating a second one beside
  /// it. Falls back to `code` when null.
  driveFolder String? @db.VarChar(64)

  books Book[]
}

model Book {
  id          String     @id @default(cuid())
  // Prisma maps String to VARCHAR(191) on MySQL, which is shorter than some
  // real book titles, so the longer columns are declared explicitly.
  title       String     @db.VarChar(300)
  author      String     @db.VarChar(200)
  year        Int?
  isbn        String?    @db.VarChar(20)
  description String?    @db.Text

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  // Store the Drive file ID, never the URL. IDs are permanent, URLs are not.
  driveFileId String?    @unique
  mimeType    String     @default("application/pdf")
  sizeBytes   Int
  pageCount   Int?
  hasThumb    Boolean    @default(false)
  // First-page render. Lives in the row, not on disk - Render's free tier has
  // no persistent disk, so a file next to the app is gone on the next deploy.
  thumbnail   Bytes?    

  status     BookStatus @default(PENDING)
  failReason String?    @db.Text

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facultyId, status, createdAt])
  @@index([title])
}

/// Caches "which folder holds this faculty's books inside this year folder".
/// Purely a lookup cache - a stale row is detected and rebuilt on the next
/// upload, so there are no relations or cascades to maintain.
///
/// This used to be keyed by uploader as well. It no longer is: there is one
/// library Drive, so the same faculty in the same year is the same folder for
/// everybody.
model FacultyFolder {
  id        String   @id @default(cuid())
  // Explicit lengths: VARCHAR(191) utf8mb4 columns in a composite unique index
  // blow past MySQL's key limit. cuids are 25 chars and Drive IDs about 33.
  facultyId String   @db.VarChar(64)
  parentId  String   @db.VarChar(64) // the year folder this one lives in
  folderId  String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@unique([facultyId, parentId])
}

/// Small key/value store for settings that belong to the installation rather
/// than to any one person - currently just which year folder is being filed
/// into. A table rather than an environment variable because an admin changes
/// it from the Storage page, without a redeploy.
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
