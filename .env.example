# ===========================================================================
# Book Portal — environment
# Every key appears exactly once. Later duplicates silently win, which is how
# the previous file ended up with an empty uploader list and no domain filter.
# Never commit this file.
# ===========================================================================


# --- Database ---------------------------------------------------------------
# Values below are for Docker Compose. `mysql` is the compose service name.
# MYSQL_USER must not be `root` — the MySQL image refuses to start with it.
# The password appears twice and must match; percent-encode it in DATABASE_URL
# only (@ becomes %40) because that one is a URL.

MYSQL_ROOT_PASSWORD=CHANGE-ME-root
MYSQL_DATABASE=bookportal
MYSQL_USER=portal
MYSQL_PASSWORD=CHANGE-ME-portal

DATABASE_URL=mysql://portal:CHANGE-ME-portal@mysql:3306/bookportal


# --- Google OAuth -----------------------------------------------------------
# One client covers sign-in and Drive. Authorised redirect URI must be exactly
#   <AUTH_URL>/api/auth/callback/google

AUTH_GOOGLE_ID=322837991627-k5lnjp58actl8h40q0rf3nahnrcb65qr.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=ROTATE-THIS-SECRET

# Generate with: openssl rand -base64 32
AUTH_SECRET=ROTATE-THIS-SECRET

# Public URL of the portal. Must match the redirect URI registered above.
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# Extra hostnames the portal is reached on. Host only, no scheme, comma
# separated. Needed for Server Actions behind a tunnel or reverse proxy.
ALLOWED_FORWARDED_HOSTS=


# --- Who may sign in and upload ---------------------------------------------
# ALLOWED_EMAIL_DOMAINS is the only gate on the library once DEFAULT_ROLE is
# UPLOADER. Leaving it blank opens sign-in to any Google account.

ALLOWED_EMAIL_DOMAINS=rua.edu.kh
DEFAULT_ROLE=UPLOADER

# Only consulted when DEFAULT_ROLE=VIEWER. Redundant above; kept for clarity.
BOOTSTRAP_UPLOADER_EMAILS=

# Promoted to ADMIN by `npm run db:seed`. Admins remove books and set the year.
SEED_ADMIN_EMAIL=cheanlyheng@rua.edu.kh


# --- The one Drive the library lives in -------------------------------------
# Every upload is written by this account, whoever is signed in. It signs in to
# the portal once per installation so a refresh token is stored for it.

DRIVE_OWNER_EMAIL=cheanlyheng@rua.edu.kh

# drive.google.com/drive/folders/<THIS PART>
DRIVE_ROOT_FOLDER_ID=1m-FSCDUQUK-L3s5Gt-KayidOQ8AWux4R
DRIVE_ROOT_FOLDER_NAME=សារណា

# Set this and no sign-in is needed on a new machine. Read it once with:
#   SELECT driveRefreshToken FROM User WHERE email = 'cheanlyheng@rua.edu.kh';
# Treat it as a password — it grants full Drive access to that account.
DRIVE_OWNER_REFRESH_TOKEN=


# --- Cover reading (optional) -----------------------------------------------
# Reads title and author off page one. Blank turns the feature off; the upload
# form still works, the two fields just start empty.

GEMINI_API_KEY=ROTATE-THIS-KEY
GEMINI_MODEL=gemini-2.5-flash
# Tried once, after GEMINI_MODEL exhausts its retries on a transient failure
# (5xx, or a raw network error like a DNS blip). Optional - defaults to
# gemini-2.5-flash-lite.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite


# --- Portal behaviour -------------------------------------------------------

HOST_PORT=3100
MAX_UPLOAD_MB=50
BLOCK_DOWNLOADS=false
DATA_DIR=/app/data
DUCKDNS_TOKEN=ec55edd3-7938-4bbd-869b-f46b71772768

# ===========================================================================
# Running without Docker (npm run dev, XAMPP or WAMP)
#
# Change exactly three lines above:
#
#   DATABASE_URL=mysql://portal:CHANGE-ME-portal@127.0.0.1:3306/bookportal
#   AUTH_URL=http://localhost:3000
#   HOST_PORT=3000
#
# The MYSQL_* keys are read only by Docker Compose; on XAMPP you create the
# database in phpMyAdmin yourself. Use 127.0.0.1 rather than localhost — on
# Windows, localhost can resolve to ::1 while MySQL listens on IPv4 only.
# ===========================================================================


# ===========================================================================
# Deploying to Render, keeping MySQL (Aiven free tier)
#
# Render has no managed MySQL. Everything else about this file stays the
# same - only DATABASE_URL changes, to an external host instead of the
# compose service name. Full walkthrough in DEPLOY-RENDER.md.
#
#   1. Create a free MySQL service at aiven.io. Download its CA certificate
#      and save it as prisma/aiven-ca.pem (it's a public cert, safe to commit).
#   2. Build the URL in Prisma's SSL format, percent-encoding the password:
#
#        DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslcert=aiven-ca.pem&sslaccept=strict
#
#   3. Set AUTH_URL and ALLOWED_FORWARDED_HOSTS to the assigned
#      *.onrender.com host (or your custom domain) once you know it.
#   4. Set every other variable above as a Render environment variable -
#      never commit real values. MYSQL_* and HOST_PORT are compose-only and
#      can be skipped.
# ===========================================================================