# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database (MySQL 8) ----------------------------------------------------
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=bookportal
MYSQL_USER=portal
MYSQL_PASSWORD=change-this-password

# Inside Docker the host is the compose service name (mysql), not localhost.
# The password appears twice - here and in MYSQL_PASSWORD above - and they must
# match. If it contains @ : / or ? you must percent-encode it here only
# (@ becomes %40), because this one is a URL.
DATABASE_URL=mysql://portal:change-this-password@mysql:3306/bookportal

# --- Running on XAMPP or WAMP instead of Docker -----------------------------
# The MYSQL_* values above are only read by Docker Compose. On XAMPP or WAMP you
# create the database yourself in phpMyAdmin and set DATABASE_URL only.
#
#   DATABASE_URL=mysql://portal:your-password@127.0.0.1:3306/bookportal
#   DATA_DIR=./data
#
# Use 127.0.0.1 rather than localhost: on Windows, localhost can resolve to ::1
# while MySQL is listening on IPv4 only, which fails with a connection error.
# If you changed MySQL's port in the control panel, change 3306 here to match.

# --- Google -----------------------------------------------------------------
# One OAuth client covers both sign-in and Drive uploads. Create it at
# console.cloud.google.com under Credentials -> OAuth client ID -> Web
# application, with this authorised redirect URI:
#   <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public URL of the portal. Must match the redirect URI above.
AUTH_URL=http://localhost:3000

# Host port when running under Docker Compose. The container always listens on
# 3000; this is only what the host publishes. Default 3100.
HOST_PORT=3100
# Behind Cloudflare Tunnel / any reverse proxy, keep this on.
AUTH_TRUST_HOST=true

# Restrict sign-in to your institution. Comma separated. Blank = any Google account.
ALLOWED_EMAIL_DOMAINS=
# These emails get upload rights on their first sign-in. Comma separated.
BOOTSTRAP_UPLOADER_EMAILS=
# Promoted to ADMIN when you run `npm run db:seed`.
SEED_ADMIN_EMAIL=

# --- Cover reading (optional) ----------------------------------------------
# Reads the title and author off page one when a PDF is chosen. Get a key at
# https://aistudio.google.com/apikey. Leave blank to turn the feature off; the
# upload form still works, the two fields just start empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Tunnels and proxies ---------------------------------------------------
# Hostnames the portal is reached on besides localhost. Host only, no scheme,
# comma separated. Required for Server Actions to work behind a dev tunnel.
ALLOWED_FORWARDED_HOSTS=

# --- Portal behaviour ------------------------------------------------------
MAX_UPLOAD_MB=50
# /app/data inside Docker. Use ./data when running on XAMPP, WAMP or bare Node.
DATA_DIR=/app/data
# true = hide Drive's download button on newly uploaded books.
BLOCK_DOWNLOADS=false
